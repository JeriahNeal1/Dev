+    lib.m0_reasons.argtypes=[C.POINTER(Input)];lib.m0_reasons.restype=C.c_uint32
+    lib.m0_init.argtypes=[C.POINTER(State)];lib.m0_observe.argtypes=[C.POINTER(State),C.POINTER(Input)]
+    assert C.sizeof(State)==32
