        p=self.get('proposals',proposal_id);status=self.bridge.request('status',{})
        if status['session']!=p['bridge_session']:raise ValueError('Editor session changed: recapture model and regenerate proposal')
        q={k:p[k] for k in ('rom_id','expected_rom_sha256','expected_model_sha256','changes','reason','evidence')};result=self.bridge.request('preview',q)
        key=self.put('events',{'captured_utc':utc(),'kind':'preview','proposal_id':proposal_id,'result':result});return {'event_id':key,**result}

def csv_rows(raw):
    text=raw.decode('utf-8-sig');reader=csv.reader(io.StringIO(text));headers=next(reader,[])
    if not headers or len(set(headers))!=len(headers):raise ValueError('Missing or duplicate CSV headers')
    rows=[];partial=False
    all_rows=list(reader)
    if len(all_rows)>500000:raise ValueError('CSV row limit exceeded; split file')
    for i,row in enumerate(all_rows):
        if not row:continue
        if len(row)!=len(headers):
            if i==len(all_rows)-1 and not text.endswith(('\n','\r')):partial=True;continue
            raise ValueError('Malformed CSV row '+str(i+2))
        rows.append(dict(zip(headers,row)))
    return headers,rows,partial

def validate_axis(a):
    if not a or not all(math.isfinite(v) for v in a):raise ValueError('Invalid axis')
    if len(a)>1 and not (all(x<y for x,y in zip(a,a[1:])) or all(x>y for x,y in zip(a,a[1:]))):raise ValueError('Axis must be strictly monotonic')

def bracket(a,v):
    validate_axis(a);finite(v)
    if len(a)==1:return [(0,1.)] if v==a[0] else None
    if a[0]>a[-1]:
        r=bracket(a[::-1],v);return None if r is None else [(len(a)-1-i,w)for i,w in r]
    if v<a[0] or v>a[-1]:return None
    i=bisect.bisect_left(a,v)
    if i<len(a) and a[i]==v:return [(i,1.)]
    f=(v-a[i-1])/(a[i]-a[i-1]);return [(i-1,1-f),(i,f)]

def filter_row(row,filters):
    for f in filters:
        v=float(row[f['column']]);finite(v)
        if 'equals'in f:
            if v!=finite(f['equals']):return False
        elif not finite(f['min'])<=v<=finite(f['max']):return False
    return True

OPS={ast.Add:operator.add,ast.Sub:operator.sub,ast.Mult:operator.mul,ast.Div:operator.truediv}
FUNCS={'abs':abs,'min':min,'max':max,'sqrt':math.sqrt,'log':math.log,'exp':math.exp}
def safe_expression(expression,variables):
    if not isinstance(expression,str) or len(expression)>2000:raise ValueError('Expression too long')
    tree=ast.parse(expression,mode='eval')
    if sum(1 for _ in ast.walk(tree))>128:raise ValueError('Expression too complex')
    def visit(n,depth=0):
        if depth>24:raise ValueError('Expression too deep')
        if isinstance(n,ast.Expression):return visit(n.body,depth+1)
        if isinstance(n,ast.Constant):return finite(n.value)
        if isinstance(n,ast.Name):
            if n.id not in variables:raise ValueError('Missing variable '+n.id)
            return finite(variables[n.id])
        if isinstance(n,ast.UnaryOp) and isinstance(n.op,(ast.USub,ast.UAdd)):return finite((-1 if isinstance(n.op,ast.USub) else 1)*visit(n.operand,depth+1))
        if isinstance(n,ast.BinOp):
            a,b=visit(n.left,depth+1),visit(n.right,depth+1)
            if isinstance(n.op,ast.Pow):
                if abs(b)>16:raise ValueError('Exponent out of bounds')
                return finite(a**b)
            if type(n.op)in OPS:return finite(OPS[type(n.op)](a,b))
        if isinstance(n,ast.Call) and isinstance(n.func,ast.Name) and n.func.id in FUNCS and not n.keywords and 1<=len(n.args)<=8:return finite(FUNCS[n.func.id](*(visit(a,depth+1)for a in n.args)))
        raise ValueError('Disallowed expression syntax')
    return finite(visit(tree))

def render_report(r):
    esc=lambda s:html.escape(str(s),quote=True)
    tr=''.join('<tr>'+''.join('<td>'+esc(c[k])+'</td>'for k in ('row','column','count','weight','mean','std','min','max'))+'</tr>'for c in r['cells'])
    # Independent scales and units: never make unlike quantities look directly comparable.
    points=r['timeline'][::max(1,len(r['timeline'])//1500)]
    points_json=json.dumps([[p['time_ms'],p['table_lookup_estimate'],p['metric']] for p in points],allow_nan=False)
