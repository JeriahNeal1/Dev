            mean=a['sum']/a['weight'];cells.append({'row':y,'column':x,'count':a['count'],'weight':a['weight'],'mean':mean,'std':math.sqrt(max(0,a['sum2']/a['weight']-mean*mean)),'min':a['min'],'max':a['max']})
        report={'captured_utc':utc(),'log_id':log_id,'snapshot_id':lm['snapshot_id'],'association':lm['association'],'table':table_key,'metric_column':metric_column,'time_column':time_column,'time_unit':time_unit,'bindings':bindings,'filters':filters,'active_table_evidence':active_table_evidence,'metric_delay_ms':metric_delay_ms,'max_alignment_gap_ms':max_alignment_gap_ms,'accepted_samples':len(timeline),'skipped':skipped,'cells':cells,'timeline':timeline,'interpolation':'analysis-side linear/bilinear estimate; not proof of ECU lookup, activation, sensor delay, or total compensation','independent_samples':'Counts are logger rows, NOT independent trials.'}
        key=self.put('overlays',report);export=self.home/'exports';export.mkdir(exist_ok=True);csvpath=export/(key+'_timeline.csv')
        with csvpath.open('w',newline='',encoding='utf-8') as f:
            writer=csv.DictWriter(f,fieldnames=['time_ms','metric_time_ms','x','y','table_lookup_estimate','metric','cell_weights']);writer.writeheader();writer.writerows(timeline)
