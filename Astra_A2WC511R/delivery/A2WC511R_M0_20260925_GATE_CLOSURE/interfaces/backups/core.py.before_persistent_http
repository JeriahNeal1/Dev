        return {'overlay_id':key,'accepted_samples':len(timeline),'skipped':skipped,'occupied_cells':len(cells),'timeline_csv':str(csvpath),'html_report':str(htmlpath),'association':lm['association']}
    def calculate(self,snapshot_id,table_key,expression,cells,constants,constraints,reason,evidence,overlay_id=None):
        s,t=self.table(snapshot_id,table_key)
        if not reason.strip() or not evidence:raise ValueError('Reason and evidence required')
        if t.get('static') or t.get('locked') or t.get('edit_capability')=='checksum_special_read_only':raise ValueError('Read-only/static/special table')
        if set(constraints)!={'minimum','maximum','max_abs_delta','min_samples','tolerance'}:raise ValueError('Explicit constraints required')
        lo,hi=finite(constraints['minimum']),finite(constraints['maximum']);delta=finite(constraints['max_abs_delta']);tol=finite(constraints['tolerance']);minn=finite(constraints['min_samples'])
        if lo>hi or min(delta,tol,minn)<0 or not minn.is_integer():raise ValueError('Invalid bounds')
        reserved={'old','row','column','mean','std','count','weight','metric_min','metric_max'}
        if set(constants)&reserved:raise ValueError('Constant shadows evidence variable')
        for k,v in constants.items():
            if not re.fullmatch('[a-zA-Z][a-zA-Z0-9_]*',k):raise ValueError('Invalid variable name')
            finite(v)
        obs={};overlay=None
        if overlay_id:
            overlay=self.get('overlays',overlay_id)
            if overlay['snapshot_id']!=snapshot_id or overlay['table']!=table_key:raise ValueError('Overlay snapshot/table mismatch')
            obs={(c['row'],c['column']):c for c in overlay['cells']}
        if not cells or len(cells)>65536:raise ValueError('Choose bounded explicit cells')
        seen=set();changes=[];rejected=[];calcs=[]
        for item in cells:
            if set(item)!={'row','column'}:raise ValueError('Cell needs row,column')
            y,x=item['row'],item['column']
            if type(y)is not int or type(x)is not int or not 0<=y<t['rows'] or not 0<=x<t['columns']:raise ValueError('Invalid cell coordinates')
            if (y,x)in seen:raise ValueError('Duplicate cell');
            seen.add((y,x));old=finite(t['cells'][y][x].get('real'));o=obs.get((y,x));n=o['count'] if o else 0
            if n<minn:rejected.append({'row':y,'column':x,'reason':'insufficient_samples','count':n});continue
            variables={'old':old,'row':y,'column':x,**constants,'count':n}
            if o:variables.update(mean=o['mean'],std=o['std'],weight=o['weight'],metric_min=o['min'],metric_max=o['max'])
            value=safe_expression(expression,variables)
            if not lo<=value<=hi or abs(value-old)>delta:rejected.append({'row':y,'column':x,'reason':'constraint_violation','calculated':value});continue
            if value==old:continue
            changes.append({'table':table_key,'row':y,'column':x,'expected_raw':finite(t['cells'][y][x]['raw']),'value':value,'tolerance':tol,'mode':'real'})
            calcs.append({'row':y,'column':x,'variables':variables,'expression':expression,'requested':value})
        proposal={'schema':'rr-proposal-v1','captured_utc':utc(),'snapshot_id':snapshot_id,'bridge_session':s['bridge_session'],'rom_id':s['rom']['rom_id'],'expected_rom_sha256':s['rom']['binary_sha256'],'expected_model_sha256':s['model_sha256'],'table':table_key,'reason':reason,'evidence':evidence,'constraints':constraints,'overlay_id':overlay_id,'calculations':calcs,'changes':changes,'rejected':rejected,'status':'CALCULATED_PROPOSAL_NOT_OPTIMUM_OR_FLASH_APPROVAL'}
        pid=self.put('proposals',proposal);return {'proposal_id':pid,'changed_cells':len(changes),'rejected_cells':rejected,'path':str(self.home/'proposals'/(pid+'.json')),'status':proposal['status']}
    def preset_proposal(self,snapshot_id,table_key,preset_name,reason,evidence):
        s,t=self.table(snapshot_id,table_key);ps=[p for p in t.get('presets',[]) if p['name']==preset_name]
        if len(ps)!=1:raise ValueError('Unknown/ambiguous native preset')
        if t['rows']!=1 or t.get('static') or t.get('locked') or t.get('edit_capability')=='checksum_special_read_only':raise ValueError('Preset table is not editable')
        if not reason.strip() or not evidence:raise ValueError('Reason and evidence required')
        p=ps[0];changes=[]
        for i,value in enumerate(p['data']):
            col=p['offset']+i
            if not 0<=col<t['columns']:raise ValueError('Preset index invalid')
            changes.append({'table':table_key,'row':0,'column':col,'expected_raw':finite(t['cells'][0][col]['raw']),'value':value,'tolerance':0,'mode':'raw'})
        proposal={'schema':'rr-proposal-v1','captured_utc':utc(),'snapshot_id':snapshot_id,'bridge_session':s['bridge_session'],'rom_id':s['rom']['rom_id'],'expected_rom_sha256':s['rom']['binary_sha256'],'expected_model_sha256':s['model_sha256'],'table':table_key,'reason':reason,'evidence':evidence,'changes':changes,'native_preset':preset_name,'status':'PRESET_PROPOSAL_REVIEW_REQUIRED'}
        pid=self.put('proposals',proposal);return {'proposal_id':pid,'changed_cells':len(changes),'native_preset':preset_name}
