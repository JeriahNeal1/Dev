"""RomRaider model adapter, immutable history, and explicitly associated CSV analysis.
No J2534, no flashing, no automatic optimization claims. Python 3.10+ / stdlib.
"""
from __future__ import annotations
import ast, bisect, csv, hashlib, html, io, json, math, operator, re, statistics, time, urllib.request, urllib.error
from pathlib import Path
from datetime import datetime, timezone

MAX_FILE=64*1024*1024

def utc(): return datetime.now(timezone.utc).isoformat()
def digest(data:bytes)->str:return hashlib.sha256(data).hexdigest()
def encoded(value)->bytes:return json.dumps(value,sort_keys=True,ensure_ascii=False,allow_nan=False,separators=(',',':')).encode('utf-8')
def finite(x):
    if isinstance(x,bool) or not isinstance(x,(float,int)) or not math.isfinite(x):raise ValueError('Expected finite number')
    return float(x)

def read_json(path):
    data=path.read_bytes()
    if len(data)>MAX_FILE:raise ValueError('File too large')
    return json.loads(data)

class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self,*args,**kwargs):raise ValueError('Bridge redirects forbidden')

class Bridge:
    def __init__(self,connection:Path):self.connection=connection
    def request(self,op,args):
        from urllib.parse import urlsplit
        c=read_json(self.connection);u=urlsplit(c['url']);token=c['token']
        if u.scheme!='http' or u.hostname!='127.0.0.1' or not u.port or u.username or u.password or u.path!='/rpc' or u.query or u.fragment:raise ValueError('Bridge must use explicit HTTP loopback /rpc')
        if not isinstance(token,str) or len(token)<48:raise ValueError('Invalid bridge token')
        req=urllib.request.Request(c['url'],encoded({'op':op,'args':args}),{'Authorization':'Bearer '+token,'Content-Type':'application/json'},method='POST')
        opener=urllib.request.build_opener(urllib.request.ProxyHandler({}),NoRedirect())
        try:
            with opener.open(req,timeout=260) as r:data=r.read(MAX_FILE+1)
        except urllib.error.HTTPError as e:
            body=e.read(4096).decode('utf-8',errors='replace');raise RuntimeError('Bridge rejected request: '+body) from e
        if len(data)>MAX_FILE:raise ValueError('Bridge response too large')
        out=json.loads(data)
        if not out.get('ok'):raise RuntimeError(out.get('error','Bridge failure'))
        return out['result']

class Store:
    def __init__(self,root:Path,bridge=None):
        self.root=root.resolve();self.home=self.root/'work'/'rr_history';self.home.mkdir(parents=True,exist_ok=True);self.bridge=bridge
