        p=(self.root/path).resolve()
        if not p.is_relative_to(self.root) or any(v in {'.runtime','.git','.codex'} for v in p.relative_to(self.root).parts):raise ValueError('Path outside project or private directory')
        if not p.is_file() or p.stat().st_size>MAX_FILE:raise ValueError('Input missing or too large')
        return p
    def put(self,kind,value):
        if kind not in {'snapshots','logs','overlays','proposals','comparisons','events'}:raise ValueError('Invalid record kind')
        data=encoded(value);key=digest(data);folder=self.home/kind;folder.mkdir(exist_ok=True);p=folder/(key+'.json')
        if p.exists():
            if p.read_bytes()!=data:raise RuntimeError('Immutable record conflict')
        else:
            with p.open('xb') as f:f.write(data)
        return key
    def get(self,kind,key):
        if kind not in {'snapshots','logs','overlays','proposals','comparisons','events'} or not re.fullmatch('[a-f0-9]{64}',key):raise ValueError('Invalid record identifier')
        p=self.home/kind/(key+'.json');raw=p.read_bytes()
        if digest(raw)!=key:raise ValueError('History integrity failure')
        return json.loads(raw)
    def capture(self,rom_id,label):
        s=self.bridge.request('snapshot',{'rom_id':rom_id});s['label']=label
        if s.get('schema')!='rr-model-snapshot-v1':raise ValueError('Unsupported model snapshot schema')
        key=self.put('snapshots',s)
        return {'snapshot_id':key,'label':label,'rom':s['rom'],'tables_and_axes':len(s['tables']),'captured_utc':s['captured_utc'],'model_sha256':s['model_sha256']}
    def history(self,kind='snapshots',limit=30):
        if kind not in {'snapshots','logs','overlays','proposals','comparisons','events'}:raise ValueError('Invalid record kind')
        out=[]
        for p in sorted((self.home/kind).glob('*.json'),key=lambda p:p.stat().st_mtime,reverse=True)[:max(1,min(limit,100))]:
            v=self.get(kind,p.stem);out.append({'id':p.stem,'label':v.get('label'),'captured_utc':v.get('captured_utc'),'table':v.get('table'),'rom_sha256':v.get('rom',{}).get('binary_sha256'),'association':v.get('association')})
        return out
    def table(self,snapshot_id,key):
        s=self.get('snapshots',snapshot_id)
        found=[t for t in s['tables'] if t['key']==key]
        if len(found)!=1:raise ValueError('Table key missing or ambiguous')
        return s,found[0]
    def compare(self,a,b,table=None):
        sa=self.get('snapshots',a);sb=self.get('snapshots',b);aa={t['key']:t for t in sa['tables']};bb={t['key']:t for t in sb['tables']};results=[]
        for key in sorted(set(aa)|set(bb)):
            if table is not None and table!=key:continue
            if key not in aa or key not in bb:results.append({'table':key,'status':'added' if key in bb else 'removed'});continue
            ta,tb=aa[key],bb[key]
            metadata=lambda t:{k:v for k,v in t.items() if k not in {'cells','presets'}}
            same_meta=metadata(ta)==metadata(tb)
            axes=[key+s for s in ('::axis','::x','::y')]
            same_axes=all(aa.get(k,{}).get('cells')==bb.get(k,{}).get('cells') for k in axes)
            if (ta['rows'],ta['columns'])!=(tb['rows'],tb['columns']):results.append({'table':key,'status':'shape_changed_no_cellwise_comparison'});continue
            changes=[]
            for y in range(ta['rows']):
                for x in range(ta['columns']):
                    ca,cb=ta['cells'][y][x],tb['cells'][y][x]
                    if ca.get('raw')!=cb.get('raw') or ca.get('real')!=cb.get('real') or ca.get('static_text')!=cb.get('static_text'):
                        va,vb=ca.get('real'),cb.get('real');delta=finite(vb)-finite(va) if va is not None and vb is not None else None
                        changes.append({'row':y,'column':x,'old_raw':ca.get('raw'),'new_raw':cb.get('raw'),'old':va,'new':vb,'delta':delta})
            if changes or not same_meta or not same_axes:results.append({'table':key,'metadata_equal':same_meta,'axes_equal':same_axes,'cellwise_meaning_comparable':same_meta and same_axes,'changes':changes})
        report={'captured_utc':utc(),'old_snapshot':a,'new_snapshot':b,'same_calid':sa['rom']['calid']==sb['rom']['calid'],'tables':results,'note':'Changed axes/scales are explicitly flagged; matching row index need not be the same operating point.'}
        key=self.put('comparisons',report);return {'comparison_id':key,'changed_table_records':len(results),'report_path':str(self.home/'comparisons'/(key+'.json')),'preview':results[:3]}
    def ingest_log(self,path,snapshot_id,association,note):
        self.get('snapshots',snapshot_id)
        if association not in {'user_attested_applied_rom','unverified_candidate_association'}:raise ValueError('Explicit ROM association required; file times do not prove flashed ROM')
        p=self.inside(path);raw=p.read_bytes();h=digest(raw);data=self.home/'log_bytes';data.mkdir(exist_ok=True);dest=data/(h+'.csv')
        if dest.exists():
            if digest(dest.read_bytes())!=h:raise ValueError('Log integrity mismatch')
        else:dest.write_bytes(raw)
        headers,rows,partial=csv_rows(raw)
        meta={'captured_utc':utc(),'source_path':str(p),'csv_sha256':h,'snapshot_id':snapshot_id,'association':association,'note':note,'columns':headers,'rows':len(rows),'partial_final_row_dropped':partial}
        key=self.put('logs',meta);return {'log_id':key,**meta}
    def overlay(self,log_id,table_key,bindings,metric_column,time_column,time_unit,filters,active_table_evidence,metric_delay_ms=0,max_alignment_gap_ms=100):
        if not active_table_evidence.strip():raise ValueError('Describe active table selection evidence or explicitly mark it unverified')
        lm=self.get('logs',log_id);s,t=self.table(lm['snapshot_id'],table_key);data=self.home/'log_bytes'/(lm['csv_sha256']+'.csv');raw=data.read_bytes()
        if digest(raw)!=lm['csv_sha256']:raise ValueError('Log bytes changed')
        headers,rows,_=csv_rows(raw)
        if time_column not in headers or metric_column not in headers:raise ValueError('Unknown time/metric column')
        if time_unit not in {'ms','s'}:raise ValueError('Time unit must be explicit ms or s')
        metric_delay_ms=finite(metric_delay_ms);max_alignment_gap_ms=finite(max_alignment_gap_ms)
        if abs(metric_delay_ms)>10000 or not 0<=max_alignment_gap_ms<=10000:raise ValueError('Alignment parameters out of bounds')
        all_t={x['key']:x for x in s['tables']}
        axis_keys={'x':table_key+'::x','y':table_key+'::y'} if table_key+'::x' in all_t else {'x':table_key+'::axis'} if table_key+'::axis' in all_t else {}
        if not axis_keys and (t['rows']!=1 or t['columns']!=1):raise ValueError('Vector without defined axis: use explicit cell calculations, not inferred log mapping')
        if set(bindings)!=set(axis_keys):raise ValueError('Bindings must match table axes '+str(sorted(axis_keys)))
        axes={}
        for axis,key in axis_keys.items():
            b=bindings[axis]
            if set(b)!={'column','unit','factor','offset'}:raise ValueError('Each binding needs column,unit,factor,offset')
            if b['column'] not in headers:raise ValueError('Unknown axis channel')
            at=all_t[key];unit=(at.get('scale') or {}).get('units') or ''
            if b['unit']!=unit:raise ValueError('Axis unit mismatch: expected '+unit)
            vals=[finite(c.get('real')) for row in at['cells'] for c in row];validate_axis(vals);axes[axis]=vals;finite(b['factor']);finite(b['offset'])
        for f in filters:
            if set(f) not in ({'column','min','max'},{'column','equals'}):raise ValueError('Filter needs explicit min/max or equals')
            if f['column'] not in headers:raise ValueError('Unknown filter column')
            if 'equals' in f:finite(f['equals'])
            else:
                if finite(f['min'])>finite(f['max']):raise ValueError('Invalid filter bounds')
        times=[]
        for row in rows:
            try:times.append(float(row[time_column])*(1000 if time_unit=='s' else 1))
            except (ValueError,TypeError):raise ValueError('Non-numeric time column')
        if not all(math.isfinite(x) for x in times) or any(b<a for a,b in zip(times,times[1:])):raise ValueError('Time resets/nonfinite: split log into sessions first')
        accum={};timeline=[];skipped={'filters_or_missing':0,'axis_outside':0,'alignment':0}
        for i,row in enumerate(rows):
            try:
                if not filter_row(row,filters):skipped['filters_or_missing']+=1;continue
                vals={k:float(row[v['column']])*finite(v['factor'])+finite(v['offset']) for k,v in bindings.items()}
                if any(not math.isfinite(v) for v in vals.values()):raise ValueError('Missing axis')
                xw=bracket(axes['x'],vals['x']) if 'x'in axes else [(0,1.)];yw=bracket(axes['y'],vals['y']) if 'y'in axes else [(0,1.)]
                if xw is None or yw is None:skipped['axis_outside']+=1;continue
                mt=times[i]+metric_delay_ms;j=bisect.bisect_left(times,mt);candidates=[k for k in (j-1,j) if 0<=k<len(times)];j=min(candidates,key=lambda k:abs(times[k]-mt)) if candidates else -1
                if j<0 or abs(times[j]-mt)>max_alignment_gap_ms:skipped['alignment']+=1;continue
                metric=float(rows[j][metric_column]);finite(metric)
                weights=[(y,x,wy*wx) for y,wy in yw for x,wx in xw if wy*wx>0];lookup=0.
                for y,x,w in weights:
                    v=finite(t['cells'][y][x].get('real'));lookup+=w*v
                    a=accum.setdefault((y,x),{'count':0,'weight':0.,'sum':0.,'sum2':0.,'min':metric,'max':metric});a['count']+=1;a['weight']+=w;a['sum']+=w*metric;a['sum2']+=w*metric*metric;a['min']=min(a['min'],metric);a['max']=max(a['max'],metric)
